{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(node tools/build.mjs --check)",
      "Bash(node tools/check-app.mjs)",
      "Bash(node tools/check-app.mjs:*)",
      "Bash(node tools/unit.mjs)",
      "Bash(node tools/smoke.mjs)",
      "Bash(node tools/edge.mjs)",
      "Bash(node tools/check-terms.mjs:*)",
      "Bash(node tools/changed-ids.mjs:*)",
      "Bash(node tools/terms.mjs:*)",
      "Bash(node tools/serve.mjs:*)",
      "Bash(node tools/verification-list.mjs)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "WebSearch"
    ],
    "deny": [
      "Bash(npx playwright install:*)",
      "Bash(playwright install:*)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)"
    ]
  }
}
